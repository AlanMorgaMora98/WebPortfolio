      color: var(--text-color);
      text-align: center;
      padding: 6px 8px;
      border-radius: 6px;
      font-size: clamp(14px, 1.125rem, 20px);
      position: absolute;
      z-index: 10;
      bottom: 125%; /* arriba del icono */
      left: 50%;
      transform: translateX(-50%);
      opacity: 0;
      transition: opacity 0.3s;
      white-space: nowrap;
    }

    .tooltip .tooltip-text::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 50%;
      margin-left: -5px;
      border-width: 5px;
      border-style: solid;
      border-color: var(--accent-color) transparent transparent transparent;
    }

    .tooltip:hover .tooltip-text {
      visibility: visible;
      opacity: 1;
