	.country {
		display: block;
		justify-self: center;
		color: #531b79;
		width: 4.5rem;
		height: 4.5rem;
		z-index: 1;
		animation: animate-rotate 10s linear infinite;
	}

	.country:hover {
		animation-play-state: paused;
	}

	.faceAlan {
		display: block;
		border-radius: 5px;
		box-shadow: inset 0 0 25px #770d0d,
		0 0 30px #770d0d;
		transition: box-shadow 0.2s linear, filter 1s linear;
		width: 9rem;
		aspect-ratio: 4 / 5;
		justify-self: center;
	}

	.faceAlan:hover {
		border-radius: 5px;
		filter: blur(1px);
		box-shadow: inset 0 0 50px #770d0d,
		0 0 50px #770d0d;
	}

	.iconScale {
		transition: transform 0.2s linear;
	}

	.iconScale:hover {
		transform: scale(1.05);
	}

	.chip {
		display: inline-block;
		background: linear-gradient(to right, var(--secondary-color), var(--primary-color));
		color: #000000;
		padding: 0.3rem 0.8rem;
		border-radius: 9999px; /* forma redondeada */
    }

	/* .chip:hover {
		//animation: animate-gradient 10s linear infinite;
	} */

	@keyframes animate-rotate {
		0% {
			transform: rotateY(0deg)
		}
		25% {
			transform: rotateY(90deg);
		}
		50% {
			transform: rotateY(180deg)
		}
		75% {
			transform: rotateY(270deg);
		}
		100% {
			transform: rotateY(360deg);
		}

	}

	@keyframes animate-gradient {
		to {
			background-position: 200%;
		}
	}


	@media (max-width: 800px) {
		.refs a:not(:first-child) {
			display: none;
		}
	}