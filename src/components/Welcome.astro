<style>

	html {
		scroll-behavior: smooth;
	}

	html, body {
		margin: 0;
		width: 100;
		height: 100%;
	}

	:root {
		--ease-out: cubic-bezier(0.5, 1, 0.89, 1);
		--ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
		--primary-color: #5ad689;
		--secondary-color: #531b79; 
		--accent-color: #770d0d;
		--text-color: #d4e5e1;
		--background-color: #1b1b1d;
		--font-title: "Bungee Hairline", sans-serif;
		--font-text: "Space Mono", sans-serif;
		--font-dot: "Doto", sans-serif;
	}

	*::selection {
		background-color: var(--secondary-color);
		color: var(--text-color);
	}

	body {
		background-color: var(--background-color);
		color: var(--text-color);
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-title);
	}

	a {
		font-family: var(--font-title);
		text-decoration: none;
		font-weight: 900;
	}

	p {
		font-family: var(--font-text);
	}

	code {
		font-family: var(--font-dot);
	}

	#container {
		height: 100%;
	}

	header {
		display: flex;
		flex-flow: row wrap;
		position: sticky;
		top: 0px;
		justify-content: space-between;
		align-items: center;
		height: 40px;
		/* background: linear-gradient(180deg, rgba(90, 214, 137, 1) 0%, rgba(90, 214, 137, 0.85) 33%, rgba(90, 214, 137, 0.70) 50%, rgba(90, 214, 137, 0.55) 67%, rgba(90, 214, 137, 0.4) 80%, rgba(90, 214, 137, 0.2) 95%,  rgba(27, 27, 29, 0.1) 100%); */
		/* background: linear-gradient(180deg, rgba(90, 214, 137, 1) 0%, rgba(59, 121, 83, 1) 50%, rgba(27, 27, 29, 0.4) 100%); */
		background: rgba(90, 214, 137, 0.8);
		backdrop-filter: blur(3px);
		/* -webkit-backdrop-filter: blur(6px); */
		color: var(--accent-color);
	}

	.refs, .links {
		display: flex;
		flex-flow: row wrap;
		justify-content: center;
		align-items: center;
		margin-left: 2%;
		margin-right: 2%;
		color: var(--secondary-color);
	}

	.refs a {
		margin-left: 10px;
		margin-right: 10px;
		padding: 8px;
		box-sizing: border-box;
		color: inherit;
		font-size: 1rem;
		/* box-shadow: 0 0 10px rgba(90, 214, 137, 0.8); */
	}

	/* .refs a:hover {
		font-weight: 900;
	} */

	.links a {
		margin-left: 10px;
		margin-right: 10px;
		padding: 8px;
		box-sizing: border-box;
		color: inherit;
	}

	.links a:hover .icon{
		stroke-width: 10%;
	}

	.icon {
		width: 1.5rem;
		height: 1.5rem;
		stroke: currentColor;
		stroke-width: 8%;
	}

	.description {
		color: var(--text-color);
		font-family: var(--font-text);
	}

	main {
		height: 100%;
		width: 100%;
		justify-content: center;
	}
		#aboutMe {
		padding: 16px;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	#hero h1 {
		color: var(--primary-color);
		font-size: 40px;
		background: linear-gradient(to right, var(--primary-color), var(--secondary-color), var(--primary-color));
		background-size: 200%;
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: animate-gradient 4.5s linear infinite;
	}


	.cardHero {
		width: 600px;
		height: 400px;
		box-sizing: border-box;
		border-radius: 20px;
		padding: 25px;
		opacity: 1;
  		background-image:
    		linear-gradient(rgba(90,214,137,0.1) 1.3px, transparent 1.3px),
    		linear-gradient(to right, rgba(90,214,137,0.1) 1.3px, transparent 1.3px);
		background-size: 20px 20px;
		box-shadow: inset 0 0 20px #5AD689;
	}

	.country {
		color: #9B43D6;
		width: 80px;
		height: 80px;
		animation: animate-rotate 10s linear infinite;
	}

	.country:hover {
		animation-play-state: paused;
	}

	.faceAlan {
		border-radius: 5px;
		box-shadow: inset 0 0 25px #770d0d,
		0 0 50px #770d0d;
	}

	.faceAlan:hover {
		border-radius: 5px;
		box-shadow: inset 0 0 50px #770d0d,
		0 0 100px #770d0d;
	}



	@keyframes animate-rotate {
		0% {
			transform: rotateY(0deg)
		}
		25% {
			transform: rotateY(90deg);
		}
		50% {
			transform: rotateY(180deg)
		}
		75% {
			transform: rotateY(270deg);
		}
		100% {
			transform: rotateY(360deg);
		}

	}

	@keyframes animate-gradient {
		to {
			background-position: 200%;
		}
	}


