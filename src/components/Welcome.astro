<style>

	html {
		scroll-behavior: smooth;
	}

	html, body {
		margin: 0;
		/* width: 100;
		height: 100vw; */
	}

	:root {
		--ease-out: cubic-bezier(0.5, 1, 0.89, 1);
		--ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
		--primary-color: #5ad689;
		--secondary-color: #531b79; 
		--accent-color: #770d0d;
		--text-color: #d4e5e1;
		--background-color: #1b1b1d;
		--font-title: "Bungee Hairline", sans-serif;
		--font-text: "Space Mono", sans-serif;
		--font-dot: "Doto", sans-serif;
	}

	*::selection {
		background-color: var(--secondary-color);
		color: var(--text-color);
	}

	body {
		/* background: linear-gradient(180deg,rgba(27, 27, 29, 1) 0%, rgba(14, 5, 21, 1) 90%, rgba(29, 9, 42, 1) 100%); */
		color: var(--text-color);
		background-color: var(--background-color);
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-title);
	}

	a {
		font-family: var(--font-title);
		text-decoration: none;
		font-weight: 900;
	}

	ul {
		list-style-image: url("../assets/Polygon.svg");
	}

	li::marker {
		font-size: 1.5rem;
	}

	#container {
		//height: 100%;
	}

	header {
		display: flex;
		flex-flow: row wrap;
		position: fixed;
		left: 0;
		right: 0;
		justify-content: space-around;
		align-items: center;
		height: 3.5rem;
		background: rgba(90, 214, 137, 0.8);
		backdrop-filter: blur(3px);
		-webkit-backdrop-filter: blur(3px);
		color: var(--accent-color);
		z-index: 10;
	}

	.refs, .links {
		display: flex;
		flex-flow: row wrap;
		justify-content: center;
		align-items: center;
		color: var(--secondary-color);
	}

	.refs a {
		margin-left: clamp(8px, 0.5rem, 16px);
		margin-right: clamp(8px, 0.5rem, 16px);
		padding: clamp(8px, 0.5rem, 16px);
		background-color: transparent;
		box-sizing: border-box;
		font-size: 1rem;
		transition: filter 0.2s linear;
		
	}

	.refs a:hover {
		filter: drop-shadow(0 0 10px  rgba(83, 27, 121, 0.8))
		drop-shadow(0 0 20px rgba(83, 27, 121, 0.6))
		drop-shadow(0 0 30px rgba(83, 27, 121, 0.4));
	}

	.links a {
		margin-left: clamp(8px, 0.5rem, 16px);
		margin-right: clamp(8px, 0.5rem, 16px);
		padding: clamp(8px, 0.5rem, 16px);
		box-sizing: border-box;
		color: var(--secondary-color);
	}

	.icon {
		width: clamp(24px, 1.5rem, 48px);
		height: clamp(24px, 1.5rem, 48px);
		stroke: currentColor;
		stroke-width: 8%;
		transition: stroke-width 0.2s linear;
	}

	.links a:hover .icon {
		stroke-width: 10%;
	}

	.description {
		display: inline-block;
		/* width: 400px;
		height: 400px; */
		color: var(--text-color);
		font-family: var(--font-text);
	}

	main {
		padding: clamp(5vw, 2.5rem, 10vw);
	}

	/* #hero {
		display: flex;
		align-items: start;
		//flex-direction: row;
		flex-flow: row wrap;
		justify-content: center;
	} */

	#hero h1 {
		color: var(--primary-color);
		padding: clamp(3rem, 2.5vw + 1rem, 60px) 0;
		text-align: center;
		font-size: clamp(3rem, 2.5vw + 1rem, 80px);
		background: linear-gradient(to right, var(--primary-color), var(--secondary-color), var(--primary-color));
		background-size: 200%;
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		animation: animate-gradient 10s linear infinite;
	}

	#hero h3 {
		text-align: center;
	}

	.cardHero {
		display: inline-grid;
		grid-template-columns: repeat(20, 1fr);
		grid-template-rows: repeat(20, 1fr);
		grid-column-gap: 0;
		grid-row-gap: 0;
		justify-items: center;
		align-items: start;
		width: 45rem;
		height: 30rem;
		box-sizing: border-box;
		border-radius: 20px;
		padding: 1.5rem;
  		background-image:
    		linear-gradient(rgba(90,214,137,0.1) 1.3px, transparent 1.3px),
    		linear-gradient(to right, rgba(90,214,137,0.1) 1.3px, transparent 1.3px);
		background-size: 20px 20px;
		box-shadow: inset 0 0 1.5rem #5AD689;
		transition: box-shadow 0.2s linear;
		font-family: var(--font-title);
		font-weight: 900;
	}

	.cardHero:hover {
		box-shadow: inset 0 0 2rem #5AD689;
	}

	.cardHero p {
		margin: 0.5rem 0;
	}

	.cardHero ul {
		margin: 0.5rem 0;
	}

	.cardHero li {
		font-size: 0.8rem;
	}

	.cardTitleSection {
		grid-area: 1 / 1 / 4 / 14;
		font-size: 1.5rem;
		justify-self: start;
		align-self: center;
		//background-color: yellow;
	}

	.cardExperienceSection {
